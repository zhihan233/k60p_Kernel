# 额外游戏/性能优化（在 LineageOS 基线 config 之上追加）
# 只添加不影响导出结构体/符号布局的选项；olddefconfig 自动解决依赖。
# 如果某个符号在本树中不存在，会被 olddefconfig 丢弃（build.sh 只告警不失败）。

# MGLRU 默认启用（LOS 基线只编入内核）
CONFIG_LRU_GEN_ENABLED=y

# 默认队列规则 fq_codel（低延迟，抗 bufferbloat）
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y

# TCP BBR（LOS 树可能已内置 BBR；这里确保拥塞控制可切换）
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_ECN=y

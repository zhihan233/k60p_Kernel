# =====================================================================
# gaming 变体额外特性（依赖 patches/full/0030 BBRv3 补丁）
# =====================================================================

# BBRv3 拥塞控制（Google 2023 版，改善移动网络/游戏延迟与吞吐）
CONFIG_TCP_CONG_BBR3=y
# 设为系统默认拥塞控制算法（替换原厂 cubic 默认）
CONFIG_DEFAULT_BBR3=y
CONFIG_DEFAULT_CUBIC=n
CONFIG_DEFAULT_BBR=n

# 经典 BBR 保留可选
CONFIG_TCP_CONG_BBR=y

# ECN / 低延迟队列
CONFIG_TCP_ECN=y
CONFIG_NET_SCH_FQ=y

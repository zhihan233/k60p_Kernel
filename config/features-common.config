# =====================================================================
# 通用特性（standard / gaming 两个变体都会启用）
# 基线 = 设备原厂 GKI 配置 (config/device-baseline.config, 5.15.194)
# =====================================================================

# --------------------- Droidspaces 容器支持 --------------------------
# 参考: https://github.com/ravindu644/Droidspaces-OSS/blob/main/Documentation/Kernel-Configuration.md
# GKI 5.15 必须配合 task_struct kABI padding 补丁 (patches/common/0001-*)
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_DEVTMPFS=y

# 网络隔离 (veth/bridge/NAT/macvlan)
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_MACVLAN=y

# 防火墙 / UFW / fail2ban 兼容
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_NF_TARGET_ULOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_LOG_IPV6=y

# tmpfs xattr/acl (NixOS 等)
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# 注意: CFS_BANDWIDTH / CGROUP_PIDS 故意保持原厂关闭状态。
# 开启会改变数千个导出符号 CRC，导致原厂 vendor 模块拒绝加载 (bootloop)。

# --------------------- BBG (Baseband-guard) 防格机 -------------------
# patches/common/0010-baseband-guard-5.15.patch 提供 security/baseband-guard/
CONFIG_BBG=y
# 是否同时保护 boot / recovery 分区：
#   默认 n —— 和原厂一样允许 root 域刷写 boot/recovery（方便后续刷内核）
#   若想彻底防格机可改为 y，但之后只能在 fastboot/recovery 里刷 boot。
CONFIG_BBG_BLOCK_BOOT=n
CONFIG_BBG_BLOCK_RECOVERY=n
# 注意: baseband_guard 必须存在于 CONFIG_LSM 列表，否则 BBG Makefile 会 $(error)
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,baseband_guard,smack,tomoyo,apparmor,bpf"

# --------------------- 游戏/性能基础优化 -----------------------------
# 多代 LRU 默认启用 (原厂配置只编进内核，默认未开启)
CONFIG_LRU_GEN_ENABLED=y

# 默认队列规则改为 fq_codel (低延迟/抗 bufferbloat)
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y

# TCP BBR (经典版；gaming 变体额外启用 BBRv3 并设为默认)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y

# 基础 ECN 支持（低延迟队列）
CONFIG_TCP_ECN=y

# --------------------- 构建修正 --------------------------------------
# 原厂配置里的 UNUSED_KSYMS_WHITELIST 指向小米构建机的绝对路径，
# 直接构建会失败，这里置空绕过。
# CONFIG_UNUSED_KSYMS_WHITELIST is not set

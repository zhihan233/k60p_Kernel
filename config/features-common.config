# =====================================================================
# 通用特性（standard / gaming 两个变体都会启用）
# 基线 = 设备原厂 GKI 配置 (config/device-baseline.config, 5.15.194)
#
# 原则：只添加 **不会改变 KMI 导出符号/结构体布局** 的选项。
# 厂商 vendor 模块是用 5.15.78 的 QC 内核树编译的，任何会改动
# struct sk_buff / struct device / nsproxy 等布局的 config 都会
# 造成跨模块 ABI 不一致（扬声器、摄像头等驱动可能失效）。
# =====================================================================

# --------------------- Droidspaces（GKI 5.15 官方清单） ----------------
# 参考：Droidspaces-OSS/Documentation/Kernel-Configuration.md 的 GKI 段
# GKI 5.15 必须配合 task_struct kABI padding 补丁 (patches/common/0001-*)
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_MACVLAN=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# 注意：CFS_BANDWIDTH / CGROUP_PIDS 必须保持原厂关闭状态（开了会改变结构体
# 布局/导出符号 CRC，导致 vendor 模块拒载）。原厂配置本来就是 n，勿加。

# --------------------- BBG (Baseband-guard) 防格机 --------------------
# patches/common/0010-baseband-guard-5.15.patch 提供 security/baseband-guard/
CONFIG_BBG=y
# 是否同时保护 boot / recovery 分区：默认 n，和原厂一样允许 root 域刷写
# boot/recovery（方便后续刷内核）；若要彻底防格机可改 y。
CONFIG_BBG_BLOCK_BOOT=n
CONFIG_BBG_BLOCK_RECOVERY=n
# baseband_guard 必须存在于 CONFIG_LSM 列表，否则 BBG Makefile 会 $(error)
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,baseband_guard,smack,tomoyo,apparmor,bpf"

# --------------------- 游戏/性能基础优化（仅默认值/模块，不改布局） ----
# 多代 LRU 默认启用（原厂只编进内核，默认关闭）
CONFIG_LRU_GEN_ENABLED=y

# 默认队列规则改为 fq_codel（低延迟）
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y

# TCP BBR（gaming 变体会额外启用 BBRv3 并设为默认）
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_ECN=y

# --------------------- 构建修正 ---------------------------------------
# ThinLTO：Full LTO 在 GitHub 共享 runner 上会 OOM。
# ThinLTO 与 CFI/KMI 兼容，CFI 类型哈希、genksyms CRC、vermagic 均不受影响。
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set

# 原厂配置里 UNUSED_KSYMS_WHITELIST 指向小米构建机绝对路径，
# 由 scripts/build.sh 在构建时改成生成的 KMI 白名单（保持 TRIM=y）。

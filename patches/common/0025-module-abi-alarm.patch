+/*
+ * ABI alarm: warn when a prebuilt vendor module's symbol CRC does not
+ * match this kernel.  Set MODULE_CRC_MISMATCH_IS_FATAL to 1 to restore
+ * strict GKI behaviour (refuse to load); default 0 keeps the system
+ * bootable and only reports the mismatch in dmesg.
+ */
+#ifndef MODULE_CRC_MISMATCH_IS_FATAL
+#define MODULE_CRC_MISMATCH_IS_FATAL 0
+#endif
+
+static struct module *abi_crc_warn_mod;
+static unsigned int abi_crc_warn_count;
+
 static int check_version(const struct load_info *info,
 			 const char *symname,
 			 struct module *mod,
@@ -1279,7 +1292,22 @@
 			return 1;
 		pr_debug("Found checksum %X vs module %lX\n",
 			 crcval, versions[i].crc);
-		goto bad_version;
+		/* ABI alarm: vendor module was built with a different CRC */
+		if (abi_crc_warn_mod != mod) {
+			abi_crc_warn_mod = mod;
+			abi_crc_warn_count = 0;
+		}
+		if (abi_crc_warn_count < 16)
+			pr_warn("%s: symbol %s CRC mismatch: module 0x%08x, kernel 0x%08x\n",
+				info->name, symname,
+				(u32)versions[i].crc, (u32)crcval);
+		else if (abi_crc_warn_count == 16)
+			pr_warn("%s: more CRC mismatches suppressed\n",
+				info->name);
+		abi_crc_warn_count++;
+		if (MODULE_CRC_MISMATCH_IS_FATAL)
+			goto bad_version;
+		return 1;
 	}
 
